# ==============================================================================
# 基础运行配置
# ==============================================================================
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this-in-production
LOG_LEVEL=INFO
LOG_IMAGE_PROMPTS=false
CORS_ORIGINS=*
BACKEND_PORT=5000
FRONTEND_PORT=3000
OUTPUT_LANGUAGE=zh

# ==============================================================================
# 全局 Provider 配置
# ------------------------------------------------------------------------------
# 文本 / 默认路由优先走哪类 provider
# 可选值：gemini | openai | lazyllm | codex
# ==============================================================================
AI_PROVIDER_FORMAT=openai

# ------------------------------ Gemini ------------------------------
GOOGLE_API_KEY=your-google-api-key

# AI Provider 格式配置
# "gemini" (默认): 使用 Google GenAI SDK
# "openai": 使用 OpenAI SDK 格式
# "volcengine": 使用火山方舟 AgentPlans（OpenAI 兼容）
# "anthropic": 使用 Anthropic (Claude) SDK 格式

# Gemini 格式配置（当 AI_PROVIDER_FORMAT=gemini 时使用）
# 代理示例: https://api.inferera.com/gemini
GOOGLE_API_BASE=https://generativelanguage.googleapis.com
GENAI_TIMEOUT=600.0
GENAI_MAX_RETRIES=2

# OpenAI 格式配置（当 AI_PROVIDER_FORMAT=openai 时使用）
OPENAI_API_KEY=your-api-key-here
# 代理示例: https://api.inferera.com/v1
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT=600.0
OPENAI_MAX_RETRIES=2
OPENAI_TEXT_API_MODE=responses

# OpenAI 图片协议适配参数（仅 openai image channel 生效）
IMAGE_OPENAI_ENDPOINT_MODE=auto
IMAGE_OPENAI_PATH_STYLE=auto
IMAGE_OPENAI_RESPONSE_FORMAT=b64_json
IMAGE_OPENAI_CHAT_FALLBACK=true
IMAGE_OPENAI_STRICT_PARAMS=true

# 火山方舟 Agent Plans 配置（当 AI_PROVIDER_FORMAT=volcengine 时使用）
# 注意: Agent Plan 需使用专属 API Key 与模型名 (doubao-seed-2.1-turbo / doubao-seedream-5.0-lite)
VOLCENGINE_API_KEY=your-volcengine-api-key-here
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/plan/v3

# Anthropic (Claude) 格式配置（当 AI_PROVIDER_FORMAT=anthropic 时使用）
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
# Global output limit for text generation and image understanding
TEXT_MAX_OUTPUT_TOKENS=32768
# Legacy ANTHROPIC_MAX_TOKENS is used only when TEXT_MAX_OUTPUT_TOKENS is unset.

# ==============================================================================
# 项目模型默认值
# ==============================================================================
TEXT_MODEL_SOURCE=openai
TEXT_MODEL=gpt-5.2

IMAGE_MODEL_SOURCE=gemini
IMAGE_MODEL=gemini-3.1-flash-image-preview
IMAGE_API_KEY=your-image-api-key
IMAGE_API_BASE=https://api.viviai.cc

IMAGE_CAPTION_MODEL_SOURCE=openai
IMAGE_CAPTION_MODEL=gpt-5.2

# ==============================================================================
# 生图渠道配置
# ------------------------------------------------------------------------------
# 当前建议保留的生图渠道：
# 1. viviai  : Gemini 原生代理
# 2. gs88    : OpenAI 兼容图片渠道
# 3. 147ai   : OpenAI 兼容图片渠道
# ------------------------------------------------------------------------------
# 使用方式：
# - viviai / gs88 / 147ai 全部通过 PROVIDER_PROFILES_FILE 指向 JSON 文件启用
# - 各渠道密钥仍单独放在 .env
# ==============================================================================

# ------------------------------ 完整示例 ------------------------------
# 可直接复制下面这组思路：
#
# 默认走 viviai：
# IMAGE_MODEL_SOURCE=gemini
# IMAGE_MODEL=gemini-3.1-flash-image-preview
# IMAGE_API_KEY=your-viviai-image-key
# PROVIDER_PROFILES_FILE=./config/provider_profiles.example.json
#
# 如需在项目设置里切到 gs88 / 147ai：
# 1. 保留下面的 GS88_API_KEY / AI147_API_KEY
# 2. 保留下面的 PROVIDER_PROFILES_FILE
# 3. 进入项目设置，选择：
#    Provider = openai
#    Channel  = gs88 或 147ai
#
# 如果你想让默认文本也走某个代理，可以再调整：
# OPENAI_API_BASE=...
# 或
# GOOGLE_API_BASE=...

# ------------------------------ 渠道密钥 ------------------------------
GS88_API_KEY=your-gs88-api-key
AI147_API_KEY=your-147ai-api-key
AZURE_SWEDEN_API_KEY=your-azure-sweden-api-key
AZURE_SWEDEN_ENDPOINT=https://your-resource.openai.azure.com
PROVIDER_PROFILES_FILE=./config/provider_profiles.example.json

# provider_profiles 文件标准写法说明：
# - 建议使用 JSON 文件，不要再把整段 JSON 塞进 .env
# - 当前示例文件：./config/provider_profiles.example.json
# - 标准字段：
#   id / channel / label / kind / provider / api_base / api_key_env / adapter / capabilities / models / model_defaults
# - Azure image profile 额外字段：
#   azure_endpoint / azure_endpoint_env / azure_api_version / azure_api_version_env
# - provider 的标准值：
#   "openai" -> 按 OpenAI 兼容协议/模型体系理解
#   "gemini" -> 按 Gemini 原生协议/模型体系理解
# - adapter 的常用值：
#   openai_image_compat -> OpenAI 图片兼容层
#   native              -> 原生协议

# Azure OpenAI image profile 示例：
# {
#   "id": "azure-sweden",
#   "channel": "azure-sweden",
#   "label": "Azure Sweden",
#   "kind": "cloud",
#   "provider": "openai",
#   "api_key_env": "AZURE_SWEDEN_API_KEY",
#   "azure_endpoint_env": "AZURE_SWEDEN_ENDPOINT",
#   "azure_api_version": "2025-04-01-preview",
#   "adapter": "native",
#   "capabilities": ["image"],
#   "models": ["gpt-image-2"],
#   "model_defaults": { "image": "gpt-image-2" }
# }

# ------------------------------ 默认切换模板 ------------------------------
# 方案 A：默认生图走 viviai
# IMAGE_MODEL_SOURCE=gemini
# IMAGE_MODEL=gemini-3.1-flash-image-preview
# IMAGE_API_KEY=your-viviai-image-key
# PROVIDER_PROFILES_FILE=./config/provider_profiles.example.json
#
# 方案 B：默认生图走 gs88
# IMAGE_MODEL_SOURCE=openai
# IMAGE_MODEL=gpt-image-2
# IMAGE_API_KEY=your-viviai-image-key
# PROVIDER_PROFILES_FILE=./config/provider_profiles.example.json
# 然后在项目设置中选：
# Provider = openai
# Channel  = gs88
#
# 方案 C：默认生图走 147ai
# IMAGE_MODEL_SOURCE=openai
# IMAGE_MODEL=gpt-image-2-low
# IMAGE_API_KEY=your-viviai-image-key
# PROVIDER_PROFILES_FILE=./config/provider_profiles.example.json
# 然后在项目设置中选：
# Provider = openai
# Channel  = 147ai

# ==============================================================================
# LazyLLM / 国内厂商 Key
# ==============================================================================
LAZYLLM_ALLOW_INTERNAL_NETWORK=True
DOUBAO_API_KEY=your-doubao-api-key
QWEN_API_KEY=your-qwen-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GLM_API_KEY=your-glm-api-key
SILICONFLOW_API_KEY=your-siliconflow-api-key
SENSENOVA_API_KEY=your-sensenova-api-key  # 旧 LazyLLM 路径；U1 生图请优先使用下方 IMAGE_* 配置
MINIMAX_API_KEY=your-minimax-api-key

# ==============================================================================
# 并发与任务
# ==============================================================================
# 可以让 text、image、image_caption 各用各的 API
# 优先级：各模型独立配置 > 全局配置
# ------------------------------
# 示例: 三个模型各用不同的 API
# ------------------------------
# # 文本模型配置
# TEXT_MODEL_SOURCE=openai|anthropic|gemini|...
# TEXT_API_KEY=text_model_api_key
# TEXT_API_BASE=https://text-model-api.com/v1
# TEXT_MODEL=gpt-4o
#
# # 图片模型配置
# IMAGE_MODEL_SOURCE=openai|anthropic|gemini|...
# IMAGE_API_KEY=image_model_api_key
# IMAGE_API_BASE=https://image-model-api.com/v1
# IMAGE_MODEL=gemini-2.5-flash-image-preview
#
# # 商汤日日新 U1.5 Lite（生图 + 参考图编辑；推荐只给图片指定此配置）
# IMAGE_MODEL_SOURCE=openai
# IMAGE_API_KEY=your-sensenova-api-key
# IMAGE_API_BASE=https://token.sensenova.cn/v1
# IMAGE_MODEL=sensenova-u1.5-lite
#
# # 图片识别模型配置
# IMAGE_CAPTION_MODEL_SOURCE=openai|anthropic|gemini|...
# IMAGE_CAPTION_API_KEY=caption_model_api_key
# IMAGE_CAPTION_API_BASE=https://caption-model-api.com/v1
# IMAGE_CAPTION_MODEL=claude-3-5-sonnet-20241022

# # AI 模型配置
# TEXT_MODEL=gemini-3-flash-preview
# IMAGE_MODEL=gemini-3-pro-image-preview
# # 图片识别模型配置（用于为解析文件中的图片生成描述）
# IMAGE_CAPTION_MODEL=gemini-3-flash-preview

# Flask 配置
# Flask/Werkzeug HTTP access logs; set to WARNING locally to quiet polling noise.
# WERKZEUG_LOG_LEVEL=WARNING
# BACKEND_PORT / FRONTEND_PORT — 留空则按 worktree 目录名自动计算端口（见 app.py / vite.config.ts）

# CORS 配置（多个地址用逗号分隔）

# 并发配置
MAX_DESCRIPTION_WORKERS=5
MAX_IMAGE_WORKERS=8
STYLE_PREVIEW_INITIAL_WORKERS=8
STYLE_PREVIEW_WORKERS=2
STYLE_PREVIEW_SLIDE_RETRIES=1
TASK_STALE_TIMEOUT_SECONDS=900

# ==============================================================================
# 文档解析 / 可编辑导出
# ==============================================================================
MINERU_TOKEN=your-mineru-token
MINERU_API_BASE=https://mineru.net
BAIDU_API_KEY=your-baidu-api-key

# ==============================================================================
# 可选：镜像源
# ==============================================================================
# DOCKER_REGISTRY=docker.1ms.run/
# GHCR_REGISTRY=ghcr.nju.edu.cn/
# APT_MIRROR=mirrors.aliyun.com
# PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
# NPM_REGISTRY=https://registry.npmmirror.com/
