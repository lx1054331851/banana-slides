# ==============================================================================
# 基础运行配置
# ==============================================================================
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this-in-production
LOG_LEVEL=INFO
LOG_IMAGE_PROMPTS=false
CORS_ORIGINS=*
BACKEND_PORT=5000
FRONTEND_PORT=3000
OUTPUT_LANGUAGE=zh

# ==============================================================================
# 全局 Provider 配置
# ------------------------------------------------------------------------------
# 文本 / 默认路由优先走哪类 provider
# 可选值：gemini | openai | lazyllm | codex
# ==============================================================================
AI_PROVIDER_FORMAT=openai

# ------------------------------ Gemini ------------------------------
GOOGLE_API_KEY=your-google-api-key
GOOGLE_API_BASE=https://generativelanguage.googleapis.com
GENAI_TIMEOUT=300.0
GENAI_MAX_RETRIES=2

# ------------------------------ OpenAI ------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT=300.0
OPENAI_MAX_RETRIES=2
OPENAI_TEXT_API_MODE=responses

# OpenAI 图片协议适配参数（仅 openai image channel 生效）
IMAGE_OPENAI_ENDPOINT_MODE=auto
IMAGE_OPENAI_PATH_STYLE=auto
IMAGE_OPENAI_RESPONSE_FORMAT=b64_json
IMAGE_OPENAI_CHAT_FALLBACK=true
IMAGE_OPENAI_STRICT_PARAMS=true

# ==============================================================================
# 项目模型默认值
# ==============================================================================
TEXT_MODEL_SOURCE=openai
TEXT_MODEL=gpt-5.2

IMAGE_MODEL_SOURCE=gemini
IMAGE_MODEL=gemini-3.1-flash-image-preview
IMAGE_API_KEY=your-image-api-key
IMAGE_API_BASE=https://api.viviai.cc

IMAGE_CAPTION_MODEL_SOURCE=openai
IMAGE_CAPTION_MODEL=gpt-5.2

# ==============================================================================
# 生图渠道配置
# ------------------------------------------------------------------------------
# 当前建议保留的生图渠道：
# 1. viviai  : Gemini 原生代理
# 2. gs88    : OpenAI 兼容图片渠道
# 3. 147ai   : OpenAI 兼容图片渠道
# ------------------------------------------------------------------------------
# 使用方式：
# - viviai 通过 IMAGE_API_BASE + IMAGE_API_KEY 启用
# - gs88 / 147ai 通过 PROVIDER_PROFILES_JSON 启用
# ==============================================================================

# ------------------------------ 完整示例 ------------------------------
# 可直接复制下面这组思路：
#
# 默认走 viviai：
# IMAGE_MODEL_SOURCE=gemini
# IMAGE_MODEL=gemini-3.1-flash-image-preview
# IMAGE_API_KEY=your-viviai-image-key
# IMAGE_API_BASE=https://api.viviai.cc
#
# 如需在项目设置里切到 gs88 / 147ai：
# 1. 保留下面的 GS88_API_KEY / AI147_API_KEY
# 2. 保留下面的 PROVIDER_PROFILES_JSON
# 3. 进入项目设置，选择：
#    Provider = openai
#    Channel  = gs88 或 147ai
#
# 如果你想让默认文本也走某个代理，可以再调整：
# OPENAI_API_BASE=...
# 或
# GOOGLE_API_BASE=...

# ------------------------------ viviai ------------------------------
# 如果当前生图默认走 viviai，保持下面两项：
# IMAGE_MODEL_SOURCE=gemini
# IMAGE_MODEL=gemini-3.1-flash-image-preview
# IMAGE_API_KEY=your-image-api-key
# IMAGE_API_BASE=https://api.viviai.cc

# ------------------------------ gs88 / 147ai ------------------------------
GS88_API_KEY=your-gs88-api-key
AI147_API_KEY=your-147ai-api-key
PROVIDER_PROFILES_JSON=[
  {
    "id":"gs88",
    "channel":"gs88",
    "label":"GS88",
    "kind":"relay",
    "provider":"openai",
    "api_base":"https://ai.gs88.shop/v1",
    "api_key_env":"GS88_API_KEY",
    "adapter":"openai_image_compat",
    "capabilities":["image"],
    "models":["gpt-image-2"],
    "model_defaults":{"image":"gpt-image-2"}
  },
  {
    "id":"147ai",
    "channel":"147ai",
    "label":"147AI",
    "kind":"relay",
    "provider":"openai",
    "api_base":"https://nn.147ai.com/v1",
    "api_key_env":"AI147_API_KEY",
    "adapter":"openai_image_compat",
    "capabilities":["image"],
    "models":[
      "gpt-image-2-low",
      "gpt-image-2-medium",
      "gpt-image-2-high",
      "gemini-2.5-flash-image",
      "gemini-2.5-flash-image-preview",
      "gemini-3-pro-image-preview",
      "gemini-3-pro-image-preview-stable",
      "gemini-3.1-flash-image-preview",
      "grok-4-image"
    ],
    "model_defaults":{"image":"gpt-image-2-low"}
  }
]

# ------------------------------ 默认切换模板 ------------------------------
# 方案 A：默认生图走 viviai
# IMAGE_MODEL_SOURCE=gemini
# IMAGE_MODEL=gemini-3.1-flash-image-preview
# IMAGE_API_KEY=your-viviai-image-key
# IMAGE_API_BASE=https://api.viviai.cc
#
# 方案 B：默认生图走 gs88
# IMAGE_MODEL_SOURCE=openai
# IMAGE_MODEL=gpt-image-2
# IMAGE_API_KEY=
# IMAGE_API_BASE=
# 然后在项目设置中选：
# Provider = openai
# Channel  = gs88
#
# 方案 C：默认生图走 147ai
# IMAGE_MODEL_SOURCE=openai
# IMAGE_MODEL=gpt-image-2-low
# IMAGE_API_KEY=
# IMAGE_API_BASE=
# 然后在项目设置中选：
# Provider = openai
# Channel  = 147ai

# ==============================================================================
# LazyLLM / 国内厂商 Key
# ==============================================================================
LAZYLLM_ALLOW_INTERNAL_NETWORK=True
DOUBAO_API_KEY=your-doubao-api-key
QWEN_API_KEY=your-qwen-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GLM_API_KEY=your-glm-api-key
SILICONFLOW_API_KEY=your-siliconflow-api-key
SENSENOVA_API_KEY=your-sensenova-api-key
MINIMAX_API_KEY=your-minimax-api-key

# ==============================================================================
# 并发与任务
# ==============================================================================
MAX_DESCRIPTION_WORKERS=5
MAX_IMAGE_WORKERS=8
STYLE_PREVIEW_INITIAL_WORKERS=8
STYLE_PREVIEW_WORKERS=2
STYLE_PREVIEW_SLIDE_RETRIES=1
TASK_STALE_TIMEOUT_SECONDS=300

# ==============================================================================
# 文档解析 / 可编辑导出
# ==============================================================================
MINERU_TOKEN=your-mineru-token
MINERU_API_BASE=https://mineru.net
BAIDU_API_KEY=your-baidu-api-key

# ==============================================================================
# 可选：镜像源
# ==============================================================================
# DOCKER_REGISTRY=docker.1ms.run/
# GHCR_REGISTRY=ghcr.nju.edu.cn/
# APT_MIRROR=mirrors.aliyun.com
# PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
# NPM_REGISTRY=https://registry.npmmirror.com/
